{
  "name": "draft-genie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate:local": "wrangler d1 migrations apply draft-genie --local",
    "migrate:remote": "wrangler d1 migrations apply draft-genie --remote",
    "deploy": "npm run build && wrangler deploy",
    "build:tap": "node build/build-tap.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tap.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5.20260730.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.0.0"
  }
}

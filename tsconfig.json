{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // tap/** and tests/tap/** target the browser + node, not the Worker runtime;
  // they are typechecked by tsconfig.tap.json with a different `types` set.
  //
  // tests/room/** is the same situation for 007: it imports web/src/lib, so
  // pulling it in here would typecheck browser code against workers-types and
  // fail on things like `RequestInit.credentials`. It is covered by
  // web/tsconfig.json instead.
  "exclude": ["web", "node_modules", "tests/tap", "tests/room"]
}

{
  // Draft Genie — single Worker: JSON API + static SPA + pre-draft sync cron.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "draft-genie",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API and scheduled-test routes must reach the Worker, never the SPA fallback.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "draft-genie",
      "database_id": "4e99107b-1b9a-46bb-8a48-5aa7cb26677e"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DRAFT_SESSION", "class_name": "DraftSession" }]
  },
  // LEGACY `migrations` array, deliberately NOT `exports`. 010's research
  // established empirically that `exports` silently provisions a KV-backed
  // Durable Object under the installed vitest pool while production is
  // SQLite-backed — so the suite would pass against a different storage engine
  // than production runs on.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DraftSession"] }],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    // Requires the neelamjai.com zone on the deploying Cloudflare account;
    // wrangler creates the DNS record and certificate automatically.
    { "pattern": "draft.neelamjai.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // neelamjai.com onboarded to Email Sending 2026-08-02 (DKIM + DMARC verified).
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM": "signin@neelamjai.com"
  }
  // Secrets (set via `wrangler secret put`, local dev via .dev.vars):
  //   SESSION_SECRET   — 32+ random bytes, base64 (session cookie HMAC)
  //   CREDENTIAL_KEY   — exactly 32 bytes, base64 (AES-256-GCM for ESPN cookies)
  //   RESEND_API_KEY   — only if EMAIL_PROVIDER=resend (not used with cloudflare)
}

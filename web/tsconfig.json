{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  // tests/room/** exercises web/src/lib and belongs to this type graph, not
  // the Worker one — see the note in ../tsconfig.json.
  "include": ["src", "../tests/room"]
}
